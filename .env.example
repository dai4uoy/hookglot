# API Keys for translation providers
# Copy this file to ~/.hookglot/.env and fill in keys for providers you use
# Only fill in the provider you've selected — others can be left blank

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Alibaba DashScope — https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# Moonshot — https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# Zhipu AI — https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# NVIDIA — https://build.nvidia.com/explore/discover (sign in for API key)
NVIDIA_API_KEY=
